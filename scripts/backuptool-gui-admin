#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Launch the backuptool GUI with administrator (root) rights *while keeping access
# to your desktop session*, so the file-chooser dialogs still open. Running the
# GUI plainly under `sudo` breaks the dialogs because root cannot reach your user
# D-Bus / X session; this wrapper passes that session through.
#
# Usage:
#   backuptool-gui-admin                      # auto-detect the installed GUI
#   BACKUPTOOL_GUI=/path/to/backuptool-gui backuptool-gui-admin
#
# Notes:
# - Forces the X11 backend (works under XWayland too). A pure-Wayland session may
#   still block GUI apps from running as root — then launch the GUI as your normal
#   user and type the paths into the fields.
set -u

# Resolve the GUI command to an ABSOLUTE path: pkexec changes the working
# directory, so a relative ./backuptool-gui would not be found by the elevated
# process.
abspath() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *)  printf '%s/%s' "$(pwd)" "$1" ;;
  esac
}
if [ -n "${BACKUPTOOL_GUI:-}" ]; then
  GUI_BIN="$(abspath "$BACKUPTOOL_GUI")"
  [ -x "$GUI_BIN" ] || { echo "Not found or not executable: $GUI_BIN  (chmod +x it?)" >&2; exit 1; }
  GUI_CMD="$GUI_BIN"
elif command -v backuptool-gui >/dev/null 2>&1; then
  GUI_CMD="$(command -v backuptool-gui)"
elif command -v backuptool >/dev/null 2>&1; then
  GUI_CMD="$(command -v backuptool) gui"
else
  echo "No backuptool GUI found. Set BACKUPTOOL_GUI=/path/to/backuptool-gui." >&2
  exit 1
fi

# pkexec needs a local login session; over SSH it fails with "No session for
# cookie". Tell the user instead of failing cryptically.
if [ -n "${SSH_CONNECTION:-}" ] && command -v pkexec >/dev/null 2>&1; then
  echo "Note: pkexec needs a local desktop session and usually fails over SSH." >&2
  echo "      Run this on the machine's own screen, not through SSH." >&2
fi

# Desktop session passed through to root so dialogs can render.
ENVV="env \
  DISPLAY=${DISPLAY:-:0} \
  XAUTHORITY=${XAUTHORITY:-$HOME/.Xauthority} \
  DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-} \
  XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-} \
  WINIT_UNIX_BACKEND=x11"

# Let root use your X server for this run; revoke on exit.
if command -v xhost >/dev/null 2>&1; then
  xhost +SI:localuser:root >/dev/null 2>&1 || true
  trap 'xhost -SI:localuser:root >/dev/null 2>&1 || true' EXIT INT TERM
fi

RC=0
if command -v pkexec >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  pkexec /usr/bin/env $ENVV $GUI_CMD "$@" || RC=$?
else
  echo "pkexec not found, falling back to sudo ..." >&2
  # shellcheck disable=SC2086
  sudo $ENVV $GUI_CMD "$@" || RC=$?
fi
exit $RC
