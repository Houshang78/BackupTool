// SPDX-License-Identifier: GPL-3.0-or-later
import { Button, LineEdit, ComboBox, CheckBox, SpinBox, GroupBox, VerticalBox, HorizontalBox, ScrollView, TabWidget, TextEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: root.win-title;
    preferred-width: 820px;
    preferred-height: 720px;
    min-width: 680px;

    // --- shared ---
    in property <float> progress;            // 0.0 .. 1.0
    in property <string> status;
    in property <string> logtext;
    in property <bool> running;

    // --- language ---
    in property <string> win-title: "backuptool";
    in property <[string]> languages;
    in-out property <int> lang-index;
    in property <string> t-language: "Language:";

    // --- backup tab: data ---
    in-out property <string> sources;
    in-out property <string> extra;
    in-out property <string> dest;
    in-out property <string> setname;
    in-out property <int> workers: 4;
    in-out property <bool> checksum;
    in-out property <bool> delete-missing;
    in-out property <bool> system;
    in-out property <bool> vss;
    in-out property <string> cipher: "none";
    in-out property <string> passphrase;
    in-out property <string> uid;
    in-out property <bool> db-dump;
    in-out property <string> db-host;
    in-out property <string> db-port;
    in-out property <string> db-user;
    in-out property <string> db-password;
    in-out property <string> db-command;

    // --- backup tab: labels ---
    in property <string> t-tab-backup: "Backup";
    in property <string> t-sources: "Sources";
    in property <string> t-pick: "Choose";
    in property <string> t-auto: "Auto";
    in property <string> t-extra: "Extra paths/files:";
    in property <string> t-uid: "UID(s)/users:";
    in property <string> t-db-group: "Databases";
    in property <string> t-db-dump: "Dump running databases";
    in property <string> t-db-cmd: "Custom dump:";
    in property <string> t-dest: "Destination:";
    in property <string> t-set: "Backup set:";
    in property <string> t-workers: "Workers:";
    in property <string> t-checksum: "Checksum compare";
    in property <string> t-delete: "Mirror deletions";
    in property <string> t-encryption: "Encryption:";
    in property <string> t-password: "Password";
    in property <string> t-start: "Start backup";
    in property <string> t-running: "running ...";
    in property <string> t-dry: "Dry run";
    in property <string> t-system: "System files";
    in property <string> t-vss: "VSS snapshot (Windows: copy locked files)";

    // --- restore tab: data ---
    in-out property <string> r-folder;
    in-out property <[string]> r-sets;
    in-out property <int> r-set-index;
    in-out property <string> r-target: "/";
    in-out property <int> r-workers: 4;
    in-out property <bool> r-reapply: true;
    in-out property <bool> r-dry;
    in-out property <string> r-passphrase;

    // --- restore tab: labels ---
    in property <string> t-tab-restore: "Restore";
    in property <string> t-folder: "Backup folder:";
    in property <string> t-rset: "Backup set:";
    in property <string> t-loadsets: "Load sets";
    in property <string> t-target: "Target root:";
    in property <string> t-reapply: "Reapply permissions/owner";
    in property <string> t-start-restore: "Start restore";

    // --- decommission tab: data ---
    in-out property <string> d-scope: "home";
    in-out property <string> d-sources;
    in-out property <string> d-dest;
    in-out property <string> d-set;
    in-out property <string> d-cipher: "none";
    in-out property <string> d-passphrase;
    in-out property <string> d-reset-action: "none";
    in-out property <bool> d-secure-wipe;
    in-out property <int> d-wipe-passes: 1;
    in-out property <string> d-defaults-dir;
    in-out property <string> d-defaults-set;
    in-out property <string> d-defaults-target: "/";
    in-out property <bool> d-allow-same-device;
    in-out property <bool> d-dry;
    in-out property <bool> d-confirm;

    // --- decommission tab: labels ---
    in property <string> t-tab-decommission: "Decommission";
    in property <string> t-scope: "Scope:";
    in property <string> t-reset-action: "Reset action:";
    in property <string> t-secure-wipe: "Securely overwrite (deleted data unrecoverable)";
    in property <string> t-wipe-passes: "Wipe passes:";
    in property <string> t-defaults-dir: "Defaults backup folder:";
    in property <string> t-defaults-set: "Defaults set:";
    in property <string> t-defaults-target: "Defaults target:";
    in property <string> t-allow-same-device: "Allow same device (unsafe)";
    in property <string> t-confirm-erase: "I understand this PERMANENTLY deletes the source";
    in property <string> t-start-decommission: "Start decommission";

    // --- clone tab: data ---
    in-out property <[string]> c-tools;
    in-out property <string> c-tool;
    in-out property <string> c-source;
    in-out property <string> c-target;
    in-out property <bool> c-dry;
    in-out property <bool> c-confirm;

    // --- clone tab: labels ---
    in property <string> t-tab-clone: "Clone";
    in property <string> t-clone-tool: "Clone tool:";
    in property <string> t-clone-source: "Source device/file:";
    in property <string> t-clone-target: "Target (will be overwritten):";
    in property <string> t-list-tools: "Detect tools";
    in property <string> t-start-clone: "Start clone";
    in property <string> t-confirm-clone: "I understand the target will be OVERWRITTEN";

    // --- callbacks ---
    callback pick-source();
    callback auto-sources();
    callback pick-dest();
    callback start-backup();
    callback language-changed(int);
    callback pick-folder();
    callback pick-target();
    callback load-sets();
    callback start-restore();
    callback pick-d-dest();
    callback pick-d-defaults();
    callback start-decommission();
    callback list-clone-tools();
    callback start-clone();

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        HorizontalBox {
            alignment: end;
            Text { vertical-alignment: center; text: root.t-language; }
            ComboBox {
                model: root.languages;
                current-index <=> root.lang-index;
                selected => { root.language-changed(self.current-index); }
            }
        }

        TabWidget {
            Tab {
                title: root.t-tab-backup;
                VerticalBox {
                    padding: 8px; spacing: 8px;
                    GroupBox {
                        title: root.t-sources;
                        HorizontalBox {
                            LineEdit { text <=> root.sources; placeholder-text: "/path/a;/path/b"; }
                            Button { text: root.t-pick; clicked => { root.pick-source(); } }
                            Button { text: root.t-auto; clicked => { root.auto-sources(); } }
                        }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-dest; }
                        LineEdit { text <=> root.dest; placeholder-text: "/Volumes/Backup"; }
                        Button { text: root.t-pick; clicked => { root.pick-dest(); } }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-set; }
                        LineEdit { text <=> root.setname; }
                        Text { vertical-alignment: center; text: root.t-workers; }
                        SpinBox { value <=> root.workers; minimum: 1; maximum: 64; }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-extra; }
                        LineEdit { text <=> root.extra; placeholder-text: "/path/x;/path/y/file.db"; }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-uid; }
                        LineEdit { text <=> root.uid; placeholder-text: "postgres;1001"; }
                    }
                    HorizontalBox {
                        CheckBox { text: root.t-checksum; checked <=> root.checksum; }
                        CheckBox { text: root.t-delete; checked <=> root.delete-missing; }
                        CheckBox { text: root.t-system; checked <=> root.system; }
                    }
                    CheckBox { text: root.t-vss; checked <=> root.vss; }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-encryption; }
                        ComboBox { model: ["none", "aes256gcm", "chacha20poly1305"]; current-value <=> root.cipher; }
                        LineEdit {
                            placeholder-text: root.t-password;
                            text <=> root.passphrase;
                            input-type: password;
                            enabled: root.cipher != "none";
                        }
                    }
                    GroupBox {
                        title: root.t-db-group;
                        VerticalBox {
                            CheckBox { text: root.t-db-dump; checked <=> root.db-dump; }
                            HorizontalBox {
                                LineEdit { placeholder-text: "Host"; text <=> root.db-host; }
                                LineEdit { placeholder-text: "Port"; text <=> root.db-port; }
                                LineEdit { placeholder-text: "User"; text <=> root.db-user; }
                                LineEdit { placeholder-text: "Pass"; text <=> root.db-password; input-type: password; }
                            }
                            HorizontalBox {
                                Text { vertical-alignment: center; text: root.t-db-cmd; }
                                LineEdit { placeholder-text: "oracle=expdp ..."; text <=> root.db-command; }
                            }
                        }
                    }
                    Button {
                        text: root.running ? root.t-running : root.t-start;
                        enabled: !root.running;
                        clicked => { root.start-backup(); }
                    }
                }
            }
            Tab {
                title: root.t-tab-restore;
                VerticalBox {
                    padding: 8px; spacing: 8px;
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-folder; }
                        LineEdit { text <=> root.r-folder; placeholder-text: "/Volumes/Backup"; }
                        Button { text: root.t-pick; clicked => { root.pick-folder(); } }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-rset; }
                        ComboBox { model: root.r-sets; current-index <=> root.r-set-index; }
                        Button { text: root.t-loadsets; clicked => { root.load-sets(); } }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-target; }
                        LineEdit { text <=> root.r-target; }
                        Button { text: root.t-pick; clicked => { root.pick-target(); } }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-workers; }
                        SpinBox { value <=> root.r-workers; minimum: 1; maximum: 64; }
                        LineEdit { placeholder-text: root.t-password; text <=> root.r-passphrase; input-type: password; }
                    }
                    HorizontalBox {
                        CheckBox { text: root.t-reapply; checked <=> root.r-reapply; }
                        CheckBox { text: root.t-dry; checked <=> root.r-dry; }
                    }
                    Button {
                        text: root.running ? root.t-running : root.t-start-restore;
                        enabled: !root.running;
                        clicked => { root.start-restore(); }
                    }
                }
            }
            Tab {
                title: root.t-tab-decommission;
                VerticalBox {
                    padding: 8px; spacing: 8px;
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-scope; }
                        ComboBox { model: ["home", "config", "disk"]; current-value <=> root.d-scope; }
                        Text { vertical-alignment: center; text: root.t-sources; }
                        LineEdit { text <=> root.d-sources; placeholder-text: "/path (scope=config/disk)"; }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-dest; }
                        LineEdit { text <=> root.d-dest; placeholder-text: "/Volumes/Stick"; }
                        Button { text: root.t-pick; clicked => { root.pick-d-dest(); } }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-set; }
                        LineEdit { text <=> root.d-set; placeholder-text: "<host>-decommission"; }
                        Text { vertical-alignment: center; text: root.t-encryption; }
                        ComboBox { model: ["none", "aes256gcm", "chacha20poly1305"]; current-value <=> root.d-cipher; }
                        LineEdit {
                            placeholder-text: root.t-password;
                            text <=> root.d-passphrase;
                            input-type: password;
                            enabled: root.d-cipher != "none";
                        }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-reset-action; }
                        ComboBox {
                            model: ["none", "delete", "restore-defaults"];
                            current-value <=> root.d-reset-action;
                        }
                        Text { vertical-alignment: center; text: root.t-wipe-passes; }
                        SpinBox { value <=> root.d-wipe-passes; minimum: 1; maximum: 35; }
                    }
                    CheckBox { text: root.t-secure-wipe; checked <=> root.d-secure-wipe; }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-defaults-dir; }
                        LineEdit { text <=> root.d-defaults-dir; placeholder-text: "(for restore-defaults)"; }
                        Button { text: root.t-pick; clicked => { root.pick-d-defaults(); } }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-defaults-set; }
                        LineEdit { text <=> root.d-defaults-set; }
                        Text { vertical-alignment: center; text: root.t-defaults-target; }
                        LineEdit { text <=> root.d-defaults-target; }
                    }
                    HorizontalBox {
                        CheckBox { text: root.t-allow-same-device; checked <=> root.d-allow-same-device; }
                        CheckBox { text: root.t-dry; checked <=> root.d-dry; }
                    }
                    CheckBox { text: root.t-confirm-erase; checked <=> root.d-confirm; }
                    Button {
                        text: root.running ? root.t-running : root.t-start-decommission;
                        enabled: !root.running;
                        clicked => { root.start-decommission(); }
                    }
                }
            }
            Tab {
                title: root.t-tab-clone;
                VerticalBox {
                    padding: 8px; spacing: 8px;
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-clone-tool; }
                        ComboBox { model: root.c-tools; current-value <=> root.c-tool; }
                        Button { text: root.t-list-tools; clicked => { root.list-clone-tools(); } }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-clone-source; }
                        LineEdit { text <=> root.c-source; placeholder-text: "/dev/disk2 or image.raw"; }
                    }
                    HorizontalBox {
                        Text { vertical-alignment: center; text: root.t-clone-target; }
                        LineEdit { text <=> root.c-target; placeholder-text: "/Volumes/Stick/image.raw"; }
                    }
                    HorizontalBox {
                        CheckBox { text: root.t-dry; checked <=> root.c-dry; }
                    }
                    CheckBox { text: root.t-confirm-clone; checked <=> root.c-confirm; }
                    Button {
                        text: root.running ? root.t-running : root.t-start-clone;
                        enabled: !root.running;
                        clicked => { root.start-clone(); }
                    }
                }
            }
        }

        Rectangle {
            height: 18px;
            background: #2d3742;
            border-radius: 4px;
            Rectangle {
                x: 0; y: 0;
                width: parent.width * root.progress;
                height: parent.height;
                background: #4ea1ff;
                border-radius: 4px;
            }
        }
        Text { text: root.status; }

        TextEdit {
            min-height: 160px;
            read-only: true;
            wrap: word-wrap;
            text: root.logtext;
        }
    }
}
